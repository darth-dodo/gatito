{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windowsill",
  "version": "0.1.0",
  "identifier": "com.darthdodo.windowsill",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Little pixel cats that live on your Mac's desktop.",
    "longDescription": "Windowsill puts pets on your desktop. Pet them, teach them tricks, and let them nap above the Dock while you work. Clicks pass through everywhere except on a pet.",
    "copyright": "darth-dodo",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
